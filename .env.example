# pathfinder-server - local Docker Compose stack (docker-compose.yml)
# Copy to .env (gitignored) and fill every value; compose refuses to start while one is empty.
# Postgres takes PF_DB_PASSWORD only when ./.local is created: after changing it, `rm -rf .local`.

# Schema owner `pathfinder`: openssl rand -hex 16
PF_DB_PASSWORD=
# Console token signing key, at least 32 characters: openssl rand -hex 32
PF_JWT_SECRET=
# Console administrators as login:password pairs, comma-separated (password at least 8 characters, no commas)
PF_ADMIN_USERS=admin:admin-admin
# Optional read-only users, same format
PF_VIEWER_USERS=
